NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Security Modal Answers (comma-separated for DOB to allow flexible checks)
NEXT_PUBLIC_SECURITY_DOB="22,nov"
NEXT_PUBLIC_SECURITY_CHARACTER="batman"
NEXT_PUBLIC_SECURITY_ANIME="levi ackerman"
NEXT_PUBLIC_SECURITY_INSTRUMENT="piano"

# Next.js Metadata Base & OG Images
NEXT_PUBLIC_METADATA_BASE="https://your-domain.com"
NEXT_PUBLIC_OG_IMAGE="/og_image.png"

# UptimeRobot (Read-Only API Key for /status page)
UPTIMEROBOT_API_KEY=your_uptimerobot_read_only_api_key
