---
interface Props {
  id?: string;
  class?: string;
}

const { id = 'theme-switcher', class: className = '' } = Astro.props;
---

<div
  id={id}
  class:list={[
    'theme-switcher relative inline-flex items-center p-0.5 rounded-full bg-surface border border-border shadow-xs select-none',
    className,
  ]}
  role="radiogroup"
  aria-label="Theme preference"
>
  {/* Sliding indicator highlight */}
  <span
    class="theme-indicator absolute inset-y-0.5 left-0 rounded-full bg-bg border border-border/80 shadow-xs pointer-events-none transition-all duration-200 ease-out"
    aria-hidden="true"
  ></span>

  {/* Light option */}
  <button
    type="button"
    role="radio"
    aria-checked="false"
    data-theme-value="light"
    class="theme-btn group relative z-10 inline-flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full text-muted hover:text-text transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-accent-from"
    aria-label="Light mode"
    title="Light mode"
    tabindex="-1"
  >
    <svg
      class="w-3.5 h-3.5 sm:w-4 sm:h-4 transition-transform duration-250 ease-out group-hover:scale-110"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
    </svg>
  </button>

  {/* System option */}
  <button
    type="button"
    role="radio"
    aria-checked="true"
    data-theme-value="system"
    class="theme-btn group relative z-10 inline-flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full text-muted hover:text-text transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-accent-from"
    aria-label="System mode"
    title="System mode (follows device setting)"
    tabindex="0"
  >
    <svg
      class="w-3.5 h-3.5 sm:w-4 sm:h-4 transition-transform duration-250 ease-out group-hover:scale-110"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="20" height="14" x="2" y="3" rx="2"></rect>
      <path d="M8 21h8M12 17v4"></path>
    </svg>
  </button>

  {/* Dark option */}
  <button
    type="button"
    role="radio"
    aria-checked="false"
    data-theme-value="dark"
    class="theme-btn group relative z-10 inline-flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-full text-muted hover:text-text transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-accent-from"
    aria-label="Dark mode"
    title="Dark mode"
    tabindex="-1"
  >
    <svg
      class="w-3.5 h-3.5 sm:w-4 sm:h-4 transition-transform duration-250 ease-out group-hover:scale-110"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </button>
</div>
