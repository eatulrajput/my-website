---
import { siteData } from '@/data/site';
import Container from './Container.astro';
import GitHub from '@/components/icons/GitHub.astro';
import LinkedIn from '@/components/icons/LinkedIn.astro';
import { Rss } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-border/80 bg-surface/60 py-12 sm:py-16 mt-20">
  <Container>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <p class="text-sm font-semibold text-text">
          {siteData.name} <span class="font-normal text-muted">· {siteData.role}</span>
        </p>
        <p class="text-xs text-muted mt-1">
          Crafted with Astro & Tailwind. Zero bloated JavaScript.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-5 sm:gap-6 text-sm">
        <a
          href={siteData.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="social-icon-link inline-flex items-center gap-1.5 text-muted hover:text-accent-from transition-all p-1"
          aria-label="GitHub Profile"
          id="footer-github"
        >
          <GitHub size={18} class="w-[18px] h-[18px]" />
          <span>GitHub</span>
        </a>

        <a
          href={siteData.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="social-icon-link inline-flex items-center gap-1.5 text-muted hover:text-accent-from transition-all p-1"
          aria-label="LinkedIn Profile"
          id="footer-linkedin"
        >
          <LinkedIn size={18} class="w-[18px] h-[18px]" />
          <span>LinkedIn</span>
        </a>

        <a
          href="/rss.xml"
          class="social-icon-link inline-flex items-center gap-1.5 text-muted hover:text-accent-from transition-all p-1"
          aria-label="RSS Feed"
          id="footer-rss"
        >
          <Rss class="w-[18px] h-[18px]" stroke-width={2} />
          <span>RSS</span>
        </a>

        <a
          href="/sitemap-index.xml"
          class="social-icon-link inline-flex items-center gap-1.5 text-muted hover:text-accent-from transition-all p-1"
          aria-label="Sitemap"
          id="footer-sitemap"
        >
          <span>Sitemap</span>
        </a>
      </div>
    </div>
  </Container>
</footer>
