---
interface Props {
  class?: string;
  hoverEffect?: boolean;
  padding?: 'none' | 'sm' | 'md' | 'lg';
}

const {
  class: className = '',
  hoverEffect = true,
  padding = 'md',
} = Astro.props;

const paddingStyles = {
  none: '',
  sm: 'p-4 sm:p-5',
  md: 'p-6 sm:p-8',
  lg: 'p-8 sm:p-10',
};
---

<div
  class:list={[
    'bg-white rounded-2xl border border-border shadow-xs overflow-hidden',
    hoverEffect && 'transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-indigo-500/5 hover:border-gray-300',
    paddingStyles[padding],
    className,
  ]}
>
  <slot />
</div>
