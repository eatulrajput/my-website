---
import WizardProgressBar from './contact/WizardProgressBar.astro';
import WizardStepIndicator from './contact/WizardStepIndicator.astro';
import WizardStep from './contact/WizardStep.astro';
import FormField from './contact/FormField.astro';
import TopicCard from './contact/TopicCard.astro';
import WizardReview from './contact/WizardReview.astro';
import WizardNavigation from './contact/WizardNavigation.astro';
import WizardSuccess from './contact/WizardSuccess.astro';
import { WIZARD_TOPICS } from '@/data/wizard-topics';
import { AlertCircle } from 'lucide-astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  id="contact-wizard"
  class:list={[
    'relative w-full max-w-2xl mx-auto rounded-2xl sm:rounded-3xl bg-surface/95 dark:bg-surface/90 border border-border/80 dark:border-border/60 shadow-xl shadow-black/5 dark:shadow-black/25 overflow-hidden backdrop-blur-xl',
    className,
  ]}
>
  {/* Top Hairline Progress Bar */}
  <WizardProgressBar initialPercent={0} />

  <div class="p-5 sm:p-8 md:p-10">
    {/* Tally Step Pill & Percentage Header */}
    <WizardStepIndicator initialStep={1} totalSteps={4} initialTitle="About you" initialPercent={0} />

    {/* Form Container */}
    <form id="contact-wizard-form" novalidate>
      {/* Honeypot Spam Protection (PRD F24) */}
      <input type="checkbox" name="botcheck" class="wizard-hidden" style="display: none;" tabindex="-1" autocomplete="off" />

      {/* Screen reader live announcement */}
      <div id="wizard-sr-announcements" class="sr-only" aria-live="polite"></div>

      <div class="wizard-height-wrapper relative">
        {/* STEP 1: Details */}
        <WizardStep
          step={1}
          active={true}
          kicker="01 · Details"
          title="Let's start with your details"
          description="Who should I reply to? Your email remains private and is only used to respond."
        >
          <div class="space-y-5 text-left">
            <FormField
              id="wizard-name"
              name="name"
              label="Your Name"
              required
              autocomplete="name"
              placeholder="e.g. Sarah Connor"
              errorMessage="Please enter your name."
            />
            <FormField
              id="wizard-email"
              name="email"
              label="Email Address"
              type="email"
              required
              autocomplete="email"
              autocapitalize="none"
              autocorrect="off"
              spellcheck="false"
              lowercase
              placeholder="e.g. sarah@example.com"
              errorMessage="Please enter a valid email address."
            />
          </div>
        </WizardStep>

        {/* STEP 2: Topic */}
        <WizardStep
          step={2}
          kicker="02 · Topic"
          title="What is on your mind?"
          description="Select the option that best describes what you would like to discuss."
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left" role="radiogroup" aria-label="Discussion topic">
            {WIZARD_TOPICS.map((topic) => (
              <TopicCard topic={topic} />
            ))}
          </div>

          <p id="error-topic" class="wizard-hidden text-xs text-rose-500 mt-3 flex items-center gap-1.5 font-medium" role="alert">
            <AlertCircle class="w-3.5 h-3.5 shrink-0" stroke-width={2} />
            <span>Please choose one topic to continue.</span>
          </p>

          <div class="hidden sm:flex items-center gap-1.5 text-xs text-muted/70 mt-4 text-left">
            <span>Tip: Press key</span>
            <kbd class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-bg border border-border text-text font-semibold">1</kbd>
            <span>-</span>
            <kbd class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-bg border border-border text-text font-semibold">4</kbd>
            <span>to select option</span>
          </div>
        </WizardStep>

        {/* STEP 3: Message */}
        <WizardStep
          step={3}
          kicker="03 · Message"
          title="Tell me about your project"
          description="Provide some context, your timeline, or any specific goals."
        >
          <div class="space-y-4 sm:space-y-5 text-left">
            <FormField
              id="wizard-message"
              name="message"
              label="Message"
              type="textarea"
              required
              rows={4}
              showCharCounter
              charCounterMin={20}
              placeholder="Hi Atul, I saw your work on React Native and would love to talk about..."
              errorMessage="Please enter a message of at least 20 characters."
            />
            <FormField
              id="wizard-company"
              name="company"
              label="Company or Website"
              optionalHint="optional"
              placeholder="e.g. Acme Corp or acme.com"
            />
          </div>
        </WizardStep>

        {/* STEP 4: Review and send */}
        <WizardStep
          step={4}
          kicker="04 · Review"
          title="Review your message"
          description="Check over your details before submitting directly to my inbox."
        >
          <WizardReview />
        </WizardStep>
      </div>

      {/* Navigation Controls */}
      <WizardNavigation />
    </form>

    {/* Confirmation / Success Panel */}
    <WizardSuccess />
  </div>
</div>
