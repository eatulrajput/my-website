---
import { AlertCircle } from 'lucide-astro';

interface Props {
  id: string;
  name: string;
  label: string;
  required?: boolean;
  type?: 'text' | 'email' | 'textarea';
  placeholder?: string;
  errorMessage?: string;
  optionalHint?: string;
  autocomplete?: string;
  autocapitalize?: string;
  autocorrect?: string;
  spellcheck?: string;
  lowercase?: boolean;
  rows?: number;
  showCharCounter?: boolean;
  charCounterMin?: number;
}

const {
  id,
  name,
  label,
  required = false,
  type = 'text',
  placeholder = '',
  errorMessage = '',
  optionalHint,
  autocomplete,
  autocapitalize,
  autocorrect,
  spellcheck,
  lowercase = false,
  rows = 4,
  showCharCounter = false,
  charCounterMin = 20,
} = Astro.props;

const groupId = `group-${name}`;
const errorId = `error-${name}`;
---

<div class="field-group" id={groupId}>
  <div class="flex items-center justify-between mb-2">
    <label for={id} class="block text-xs font-semibold text-text uppercase tracking-wider">
      {label}
      {required ? <span class="text-rose-500">*</span> : null}
      {optionalHint ? <span class="text-muted/70 font-normal lowercase">({optionalHint})</span> : null}
    </label>
    {showCharCounter && (
      <span id="wizard-char-counter" class="text-xs text-muted font-medium font-mono">
        0 / {charCounterMin} chars min
      </span>
    )}
  </div>

  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      rows={rows}
      required={required}
      placeholder={placeholder}
      class="wizard-input w-full px-4 py-3 sm:py-3.5 rounded-xl bg-bg/80 dark:bg-bg/50 border border-border/80 text-text placeholder:text-muted/50 transition-all text-base leading-relaxed resize-y min-h-[110px] focus:bg-surface focus:border-accent-from"
    ></textarea>
  ) : (
    <input
      type={type}
      id={id}
      name={name}
      required={required}
      autocomplete={autocomplete}
      autocapitalize={autocapitalize}
      autocorrect={autocorrect}
      spellcheck={spellcheck}
      placeholder={placeholder}
      class:list={[
        'wizard-input w-full px-4 py-3 sm:py-3.5 rounded-xl bg-bg/80 dark:bg-bg/50 border border-border/80 text-text placeholder:text-muted/50 transition-all text-base min-h-[48px] focus:bg-surface focus:border-accent-from',
        lowercase && 'lowercase',
      ]}
    />
  )}

  {errorMessage && (
    <p id={errorId} class="wizard-hidden text-xs text-rose-500 mt-2 flex items-center gap-1.5 font-medium" role="alert">
      <AlertCircle class="w-3.5 h-3.5 shrink-0" stroke-width={2} />
      <span>{errorMessage}</span>
    </p>
  )}
</div>
