---
import { ArrowLeft, ArrowRight, Send } from 'lucide-astro';
---

{/* Tally Navigation Bar */}
<div class="mt-8 pt-5 border-t border-border/70 flex items-center justify-between gap-3">
  {/* Back Button */}
  <div>
    <button
      type="button"
      id="wizard-btn-back"
      class="wizard-hidden inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-medium text-muted hover:text-text hover:bg-bg border border-border/80 transition-all min-h-[44px] cursor-pointer"
    >
      <ArrowLeft class="w-4 h-4" stroke-width={2} />
      <span>Back</span>
    </button>
  </div>

  {/* Action Controls */}
  <div class="flex items-center gap-3 ml-auto">
    {/* Keyboard shortcut hint */}
    <div class="hidden sm:flex items-center gap-1.5 text-xs text-muted/70 mr-1" id="wizard-kbd-hint">
      <span>Press</span>
      <kbd class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-bg border border-border text-text font-semibold">Enter ↵</kbd>
    </div>

    {/* Next Button (Steps 1-3) */}
    <button
      type="button"
      id="wizard-btn-next"
      class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl text-sm font-semibold bg-text text-bg hover:opacity-90 active:scale-[0.98] transition-all shadow-sm min-h-[44px] cursor-pointer"
    >
      <span>Continue</span>
      <ArrowRight class="w-4 h-4" stroke-width={2} />
    </button>

    {/* Send Button (Step 4 only) */}
    <button
      type="submit"
      id="wizard-btn-submit"
      class="wizard-hidden inline-flex items-center justify-center gap-2 px-7 py-2.5 rounded-xl text-sm font-bold bg-gradient-to-r from-accent-from via-accent-via to-accent-to text-white shadow-md hover:shadow-lg hover:brightness-105 active:scale-[0.98] transition-all min-h-[44px] cursor-pointer"
    >
      <span id="btn-submit-text">Send Message</span>
      <Send id="btn-submit-icon" class="w-4 h-4" stroke-width={2} />
      <svg
        id="btn-submit-spinner"
        class="wizard-hidden animate-spin w-4 h-4 text-white"
        fill="none"
        viewBox="0 0 24 24"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </button>
  </div>
</div>
