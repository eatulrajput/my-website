---
import { Check, RotateCcw, Mail } from 'lucide-astro';
---

{/* SUCCESS CONFIRMATION PANEL */}
<div
  id="wizard-success-panel"
  class="wizard-hidden py-8 sm:py-12 px-4 text-center flex flex-col items-center justify-center transition-all duration-400"
  role="status"
  aria-live="polite"
>
  <div class="relative flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-available/10 text-available mb-6 shadow-xs border border-available/20">
    <svg class="w-8 h-8 sm:w-10 sm:h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12" class="animate-draw-check" />
    </svg>
  </div>

  <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold bg-available/10 text-available border border-available/20 mb-3">
    <Check class="w-3.5 h-3.5" />
    <span>Delivered</span>
  </div>

  <h3 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight mb-2">
    Message sent successfully!
  </h3>

  <p class="text-base text-muted max-w-md mx-auto mb-2 leading-relaxed">
    Thanks for reaching out, <strong id="success-sender-name" class="text-text font-bold">there</strong>.
  </p>
  <p class="text-sm text-muted max-w-md mx-auto mb-8 leading-relaxed">
    Your message is safely in my inbox. I typically respond within 24–48 hours.
  </p>

  <div class="flex flex-wrap items-center justify-center gap-3">
    <button
      type="button"
      id="wizard-btn-reset"
      class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold bg-surface border border-border hover:border-accent-from text-text transition-all shadow-xs min-h-[44px] cursor-pointer active:scale-95"
    >
      <RotateCcw class="w-3.5 h-3.5" stroke-width={2} />
      <span>Send another message</span>
    </button>

    <a
      href="mailto:hello@atulrajput.dev"
      class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold text-muted hover:text-text hover:bg-bg border border-transparent hover:border-border transition-all min-h-[44px]"
    >
      <Mail class="w-3.5 h-3.5" stroke-width={2} />
      <span>hello@atulrajput.dev</span>
    </a>
  </div>
</div>
