---
import { Calendar, Clock } from 'lucide-astro';

interface Props {
  date: Date;
  readingTime?: string;
  class?: string;
}

const { date, readingTime = '4 min read', class: className = '' } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(date);
---

<div class:list={['flex flex-wrap items-center gap-2 sm:gap-3 text-xs sm:text-sm text-muted font-medium', className]}>
  <div class="inline-flex items-center gap-1.5 whitespace-nowrap">
    <Calendar class="w-3.5 h-3.5 text-muted/80" stroke-width={2} />
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </div>
  <span class="text-border dark:text-border/80 select-none" aria-hidden="true">•</span>
  <div class="inline-flex items-center gap-1.5 whitespace-nowrap">
    <Clock class="w-3.5 h-3.5 text-muted/80" stroke-width={2} />
    <span>{readingTime}</span>
  </div>
</div>
