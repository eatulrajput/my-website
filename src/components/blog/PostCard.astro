---
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import PostMeta from './PostMeta.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  readingTime?: string;
}

const {
  title,
  description,
  date,
  slug,
  tags = [],
  readingTime = '4 min read',
} = Astro.props;
---

<a href={`/blog/${slug}`} class="block group text-left">
  <Card class="h-full flex flex-col justify-between group-hover:border-accent-from/50">
    <div>
      <div class="flex items-center justify-between gap-4 mb-3">
        <PostMeta date={date} readingTime={readingTime} />
        {tags[0] && <Badge variant="subtle">{tags[0]}</Badge>}
      </div>

      <h3 class="text-lg sm:text-xl font-bold text-text group-hover:text-accent-from transition-colors line-clamp-2 mb-2 leading-snug">
        {title}
      </h3>

      <p class="text-sm text-muted line-clamp-3 leading-relaxed">
        {description}
      </p>
    </div>

    <div class="mt-4 pt-3 border-t border-border/50 flex items-center text-xs font-semibold text-accent-from group-hover:text-accent-via">
      Read article
      <svg
        class="w-3.5 h-3.5 ml-1 transition-transform group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </div>
  </Card>
</a>
