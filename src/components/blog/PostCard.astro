---
import { Calendar, Clock, ArrowRight } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
  readingTime?: string;
  class?: string;
}

const {
  title,
  description,
  date,
  slug,
  tags = [],
  readingTime = '4 min read',
  class: className = '',
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(date);

const primaryTag = tags[0];
const secondaryTags = tags.slice(1, 3);
---

<a
  href={`/blog/${slug}`}
  class:list={[
    'group relative flex flex-col justify-between h-full rounded-2xl bg-surface/90 dark:bg-surface/50 border border-border/80 dark:border-border/60 hover:border-accent-from/50 dark:hover:border-accent-from/40 p-6 sm:p-7 transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-xl hover:shadow-accent-from/10 dark:hover:shadow-[0_12px_32px_-12px_rgba(96,165,250,0.15)] overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-from focus-visible:ring-offset-2 text-left',
    className,
  ]}
  aria-label={`Read article: ${title}`}
>
  {/* Top animated accent hairline */}
  <div
    class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-accent-from via-accent-via to-accent-to opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  {/* Ambient background glow on card hover */}
  <div
    class="pointer-events-none absolute -inset-px rounded-2xl bg-gradient-to-b from-accent-from/[0.07] via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  {/* Card Main Body */}
  <div class="relative z-10 flex flex-col flex-1">
    {/* Meta Header: Category & Read Time */}
    <div class="flex items-center justify-between gap-3 mb-4">
      {primaryTag ? (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold tracking-wide bg-accent-from/10 text-accent-from border border-accent-from/20 dark:bg-accent-from/15 dark:border-accent-from/30 whitespace-nowrap">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-from" aria-hidden="true"></span>
          {primaryTag}
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold tracking-wide bg-surface text-muted border border-border/80 whitespace-nowrap">
          Article
        </span>
      )}

      <span class="inline-flex items-center gap-1 text-xs font-medium text-muted whitespace-nowrap bg-bg/80 dark:bg-bg/60 px-2 py-0.5 rounded-md border border-border/60">
        <Clock class="w-3 h-3 text-muted/70" stroke-width={2} />
        {readingTime}
      </span>
    </div>

    {/* Title */}
    <h3 class="text-lg sm:text-xl font-bold tracking-tight text-text group-hover:text-accent-from transition-colors duration-200 line-clamp-2 leading-snug mb-2.5">
      {title}
    </h3>

    {/* Description / Excerpt */}
    <p class="text-sm text-muted line-clamp-3 leading-relaxed mb-4">
      {description}
    </p>

    {/* Secondary Tags (if available) */}
    {secondaryTags.length > 0 && (
      <div class="flex flex-wrap items-center gap-1.5 mt-auto pt-1 mb-2">
        {secondaryTags.map((tag) => (
          <span class="inline-flex items-center text-[11px] font-medium text-muted/75 bg-bg/50 dark:bg-bg/60 px-2 py-0.5 rounded border border-border/40">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>

  {/* Card Footer: Date & Read CTA */}
  <div class="relative z-10 mt-5 pt-4 border-t border-border/60 dark:border-border/50 flex items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-1.5 text-muted font-medium whitespace-nowrap">
      <Calendar class="w-3.5 h-3.5 text-muted/70" stroke-width={2} />
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>

    <div class="inline-flex items-center gap-1.5 font-semibold text-accent-from group-hover:text-accent-via transition-colors whitespace-nowrap">
      <span>Read article</span>
      <div class="w-6 h-6 rounded-full bg-accent-from/10 dark:bg-accent-from/20 flex items-center justify-center transition-all duration-300 group-hover:bg-accent-from group-hover:text-white group-hover:translate-x-1">
        <ArrowRight class="w-3.5 h-3.5 transition-transform duration-300" stroke-width={2.5} />
      </div>
    </div>
  </div>
</a>
