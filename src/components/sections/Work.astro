---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Badge from '@/components/ui/Badge.astro';
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import Button from '@/components/ui/Button.astro';
import GitHub from '@/components/icons/GitHub.astro';
import { ArrowUpRight } from 'lucide-astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="py-16 sm:py-24" id="work">
  <Container>
    <SectionHeading
      kicker="Selected Work"
      title="Apps built for real-world impact"
      subtitle="Production mobile applications engineered with React Native, focused on high frame rates, offline resilience, and delightful UX."
      id="work-heading"
    />

    <div class="projects-stack relative mt-12 pb-20 sm:pb-32 lg:pb-40">
      {
        projects.map((project, index) => {
          const { title, summary, role, stack, outcome, links, cover, video } = project.data;
          const isEven = index % 2 === 1;

          return (
            <div
              class="project-card-pin sticky mb-12 sm:mb-20 lg:mb-24 last:mb-0"
              style={`--index: ${index}; z-index: ${index + 10};`}
              data-project-index={index}
            >
              <article
                class="project-card reveal group bg-surface rounded-3xl border border-border/80 hover:border-accent-from/30 p-6 sm:p-10 transition-all duration-300"
                style={`--delay: ${index * 120}ms;`}
              >
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                  {/* Project Details */}
                  <div class:list={['lg:col-span-7 flex flex-col justify-center', isEven && 'lg:order-2']}>
                    <div class="flex flex-wrap items-center gap-2 mb-4">
                      {stack.map((tech) => (
                        <Badge variant="subtle">{tech}</Badge>
                      ))}
                    </div>

                    <h3 class="text-2xl sm:text-3xl font-bold text-text mb-3 tracking-tight">
                      {title}
                    </h3>

                    <p class="text-base sm:text-lg text-muted mb-6 leading-relaxed">
                      {summary}
                    </p>

                    <div class="space-y-4 rounded-xl bg-bg/60 p-4 sm:p-5 border border-border/60 mb-6 text-sm">
                      <div>
                        <span class="font-semibold text-text">Role & Ownership:</span>{' '}
                        <span class="text-muted">{role}</span>
                      </div>
                      <div>
                        <span class="font-semibold text-text">Key Outcome:</span>{' '}
                        <span class="text-muted">{outcome}</span>
                      </div>
                    </div>

                    {/* Project Links */}
                    <div class="flex flex-wrap items-center gap-3 pt-2">
                      {links.live && (
                        <Button
                          href={links.live}
                          variant="primary"
                          size="sm"
                          id={`project-${project.id}-live`}
                        >
                          Live Demo
                          <ArrowUpRight class="w-4 h-4 ml-1" stroke-width={2} />
                        </Button>
                      )}

                      {links.appStore && (
                        <Button
                          href={links.appStore}
                          variant="secondary"
                          size="sm"
                          id={`project-${project.id}-appstore`}
                        >
                          App Store
                          <ArrowUpRight class="w-4 h-4 ml-1" stroke-width={2} />
                        </Button>
                      )}

                      {links.playStore && (
                        <Button
                          href={links.playStore}
                          variant="secondary"
                          size="sm"
                          id={`project-${project.id}-playstore`}
                        >
                          Google Play
                          <ArrowUpRight class="w-4 h-4 ml-1" stroke-width={2} />
                        </Button>
                      )}

                      {links.testFlight && (
                        <Button
                          href={links.testFlight}
                          variant="secondary"
                          size="sm"
                          id={`project-${project.id}-testflight`}
                        >
                          TestFlight
                          <ArrowUpRight class="w-4 h-4 ml-1" stroke-width={2} />
                        </Button>
                      )}

                      {links.github && (
                        <Button
                          href={links.github}
                          variant="outline"
                          size="sm"
                          id={`project-${project.id}-github`}
                        >
                          Source Code
                          <GitHub size={16} class="w-4 h-4 ml-1" />
                        </Button>
                      )}
                    </div>
                  </div>

                  {/* Phone Preview */}
                  <div class:list={['lg:col-span-5 flex justify-center', isEven && 'lg:order-1']}>
                    <PhoneFrame
                      title={title}
                      cover={cover}
                      video={video}
                    />
                  </div>
                </div>
              </article>
            </div>
          );
        })
      }
    </div>
  </Container>
</section>

<script>
  function setupProjectCardStacking() {
    const pins = Array.from(document.querySelectorAll<HTMLElement>('.project-card-pin'));
    if (pins.length <= 1) return;

    const cards = pins.map((pin) => pin.querySelector<HTMLElement>('.project-card'));

    const updateStackEffects = () => {
      const total = pins.length;

      pins.forEach((pin, i) => {
        const card = cards[i];
        if (!card) return;

        let overlap = 0;

        for (let j = i + 1; j < total; j++) {
          const nextPin = pins[j];
          const nextRect = nextPin.getBoundingClientRect();
          const nextStickyTop = parseFloat(getComputedStyle(nextPin).top) || (80 + j * 24);

          const triggerDistance = 90;
          if (nextRect.top <= nextStickyTop + triggerDistance) {
            const progress = Math.min(
              1,
              Math.max(0, (nextStickyTop + triggerDistance - nextRect.top) / triggerDistance)
            );
            overlap += progress;
          }
        }

        if (overlap > 0) {
          const scale = 1 - overlap * 0.035;
          const brightness = 1 - overlap * 0.05;
          card.style.transform = `scale(${scale.toFixed(4)})`;
          card.style.filter = `brightness(${brightness.toFixed(4)})`;
        } else {
          card.style.transform = '';
          card.style.filter = '';
        }
      });
    };

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          updateStackEffects();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    updateStackEffects();

    // Clicking the exposed top tab of a card underneath scrolls it back into full view
    pins.forEach((pin) => {
      pin.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a, button, input')) return;

        const rect = pin.getBoundingClientRect();
        if (e.clientY >= rect.top && e.clientY <= rect.top + 45) {
          const stickyTop = parseFloat(getComputedStyle(pin).top) || 80;
          window.scrollTo({
            top: window.scrollY + rect.top - stickyTop,
            behavior: 'smooth'
          });
        }
      });
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupProjectCardStacking);
    } else {
      setupProjectCardStacking();
    }
    document.addEventListener('astro:page-load', setupProjectCardStacking);
  }
</script>

<style>
  .project-card-pin {
    position: sticky;
    --stack-base-top: 4.5rem;
    --stack-step: 1rem;
    top: calc(var(--stack-base-top) + var(--stack-step) * var(--index, 0));
  }

  @media (min-width: 640px) {
    .project-card-pin {
      --stack-base-top: 5rem;
      --stack-step: 1.5rem;
    }
  }

  .project-card {
    transform-origin: top center;
    box-shadow: 0 -4px 24px -2px rgba(15, 23, 42, 0.06),
                0 20px 25px -5px rgba(15, 23, 42, 0.1),
                0 8px 10px -6px rgba(15, 23, 42, 0.06);
    will-change: transform, filter;
  }

  :global([data-theme="dark"]) .project-card {
    box-shadow: 0 -4px 24px -2px rgba(0, 0, 0, 0.4),
                0 20px 25px -5px rgba(0, 0, 0, 0.6),
                0 8px 10px -6px rgba(0, 0, 0, 0.4);
  }

  .project-card.visible {
    transition: opacity 0.5s ease-out,
                transform 0.15s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card.visible {
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
  }
</style>
