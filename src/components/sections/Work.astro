---
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Badge from '@/components/ui/Badge.astro';
import PhoneFrame from '@/components/ui/PhoneFrame.astro';
import Button from '@/components/ui/Button.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="py-16 sm:py-24" id="work">
  <Container>
    <SectionHeading
      kicker="Selected Work"
      title="Apps built for real-world impact"
      subtitle="Production mobile applications engineered with React Native, focused on high frame rates, offline resilience, and delightful UX."
      id="work-heading"
    />

    <div class="space-y-16 sm:space-y-24 mt-12">
      {
        projects.map((project, index) => {
          const { title, summary, role, stack, outcome, links, cover, video } = project.data;
          const isEven = index % 2 === 1;

          return (
            <article
              class="reveal group bg-surface rounded-3xl border border-border p-6 sm:p-10 shadow-xs hover:shadow-xl hover:shadow-accent-from/5 transition-all duration-300"
              style={`--delay: ${index * 120}ms;`}
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                {/* Project Details */}
                <div class:list={['lg:col-span-7 flex flex-col justify-center', isEven && 'lg:order-2']}>
                  <div class="flex flex-wrap items-center gap-2 mb-4">
                    {stack.map((tech) => (
                      <Badge variant="subtle">{tech}</Badge>
                    ))}
                  </div>

                  <h3 class="text-2xl sm:text-3xl font-bold text-text mb-3 tracking-tight">
                    {title}
                  </h3>

                  <p class="text-base sm:text-lg text-muted mb-6 leading-relaxed">
                    {summary}
                  </p>

                  <div class="space-y-4 rounded-xl bg-bg/60 p-4 sm:p-5 border border-border/60 mb-6 text-sm">
                    <div>
                      <span class="font-semibold text-text">Role & Ownership:</span>{' '}
                      <span class="text-muted">{role}</span>
                    </div>
                    <div>
                      <span class="font-semibold text-text">Key Outcome:</span>{' '}
                      <span class="text-muted">{outcome}</span>
                    </div>
                  </div>

                  {/* Project Links */}
                  <div class="flex flex-wrap items-center gap-3 pt-2">
                    {links.live && (
                      <Button
                        href={links.live}
                        variant="primary"
                        size="sm"
                        id={`project-${project.id}-live`}
                      >
                        Live Demo
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </Button>
                    )}

                    {links.appStore && (
                      <Button
                        href={links.appStore}
                        variant="secondary"
                        size="sm"
                        id={`project-${project.id}-appstore`}
                      >
                        App Store
                      </Button>
                    )}

                    {links.playStore && (
                      <Button
                        href={links.playStore}
                        variant="secondary"
                        size="sm"
                        id={`project-${project.id}-playstore`}
                      >
                        Google Play
                      </Button>
                    )}

                    {links.testFlight && (
                      <Button
                        href={links.testFlight}
                        variant="secondary"
                        size="sm"
                        id={`project-${project.id}-testflight`}
                      >
                        TestFlight
                      </Button>
                    )}

                    {links.github && (
                      <Button
                        href={links.github}
                        variant="outline"
                        size="sm"
                        id={`project-${project.id}-github`}
                      >
                        Source Code
                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                        </svg>
                      </Button>
                    )}
                  </div>
                </div>

                {/* Phone Preview */}
                <div class:list={['lg:col-span-5 flex justify-center', isEven && 'lg:order-1']}>
                  <PhoneFrame
                    title={title}
                    cover={cover}
                    video={video}
                  />
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </Container>
</section>
