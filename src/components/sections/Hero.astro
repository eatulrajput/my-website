---
import { siteData } from "@/data/site";
import Container from "@/components/ui/Container.astro";
import StatusPill from "@/components/ui/StatusPill.astro";
import Button from "@/components/ui/Button.astro";
import GradientText from "@/components/ui/GradientText.astro";
import RotatingText from "@/components/ui/RotatingText.astro";
import { ArrowDown } from "lucide-astro";
---

<section
  class="relative pt-12 pb-16 sm:pt-20 sm:pb-28 overflow-hidden"
  id="hero"
>
  {/* Blurred background animated gradient blobs */}
  <div class="gradient-mesh" aria-hidden="true">
    <div class="hero-blob hero-blob-tr"></div>
    <div class="hero-blob hero-blob-bl"></div>
  </div>

  <Container class="relative z-10">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center">
      {/* Availability pill */}
      <div class="reveal mb-6" style="--delay: 100ms;">
        <StatusPill text={siteData.availability} />
      </div>

      {/* Main headline */}
      <h1
        class="reveal text-fluid-hero font-extrabold tracking-tight text-text leading-[1.08] mb-6"
        style="--delay: 180ms;"
      >
        I build fast, <GradientText serif={true}
          >{siteData.accentWord}</GradientText
        > mobile apps with <RotatingText
          words={siteData.heroTechTerms}
          suffix="."
        />
      </h1>

      {/* Subtext */}
      <p
        class="reveal text-lg sm:text-xl text-muted leading-relaxed max-w-2xl mb-10"
        style="--delay: 260ms;"
      >
        {siteData.subtext}
      </p>

      {/* Action buttons */}
      <div
        class="reveal flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto"
        style="--delay: 340ms;"
      >
        <Button
          variant="primary"
          size="lg"
          href="#work"
          id="hero-btn-work"
          class="w-full sm:w-auto shadow-md shadow-accent-from/20"
        >
          View work
          <ArrowDown class="w-4 h-4 ml-1" stroke-width={2} />
        </Button>

        <Button
          variant="secondary"
          size="lg"
          href="#contact"
          id="hero-btn-contact"
          class="w-full sm:w-auto"
        >
          Get in touch
        </Button>
      </div>

      {/* Mobile-first highlights row */}
      <div
        class="reveal mt-14 pt-8 border-t border-border/60 grid grid-cols-3 gap-4 text-center w-full max-w-xl"
        style="--delay: 420ms;"
      >
        <div>
          <div class="text-xl sm:text-2xl font-bold text-text">60 FPS</div>
          <div class="text-xs text-muted mt-0.5">Smooth UI Target</div>
        </div>
        <div>
          <div class="text-xl sm:text-2xl font-bold text-text">
            iOS & Android
          </div>
          <div class="text-xs text-muted mt-0.5">Cross-Platform</div>
        </div>
        <div>
          <div class="text-xl sm:text-2xl font-bold text-text">Production</div>
          <div class="text-xs text-muted mt-0.5">Shipped to Stores</div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .gradient-mesh {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .hero-blob {
    position: absolute;
    filter: blur(60px);
    will-change: transform;
    pointer-events: none;
  }

  /* Top-Right Blob */
  .hero-blob-tr {
    top: -15%;
    right: -10%;
    width: clamp(340px, 45vw, 600px);
    height: clamp(340px, 45vw, 600px);
    background: radial-gradient(
      circle,
      rgba(59, 130, 246, 0.40) 0%,
      rgba(6, 182, 212, 0.30) 40%,
      rgba(147, 51, 234, 0.16) 70%,
      transparent 85%
    );
    border-radius: 60% 40% 70% 30% / 50% 60% 40% 50%;
    animation: blobFloatTR 9s ease-in-out infinite;
  }

  /* Bottom-Left Blob */
  .hero-blob-bl {
    bottom: -20%;
    left: -8%;
    width: clamp(300px, 40vw, 540px);
    height: clamp(300px, 40vw, 540px);
    background: radial-gradient(
      circle,
      rgba(16, 185, 129, 0.35) 0%,
      rgba(6, 182, 212, 0.25) 40%,
      rgba(59, 130, 246, 0.14) 70%,
      transparent 85%
    );
    border-radius: 40% 60% 35% 65% / 60% 35% 65% 40%;
    animation: blobFloatBL 11s ease-in-out infinite;
  }

  /* Dark mode vibrant glowing colors */
  :global([data-theme="dark"]) .hero-blob-tr {
    background: radial-gradient(
      circle,
      rgba(96, 165, 250, 0.45) 0%,
      rgba(34, 211, 238, 0.32) 40%,
      rgba(168, 85, 247, 0.22) 70%,
      transparent 85%
    );
  }

  :global([data-theme="dark"]) .hero-blob-bl {
    background: radial-gradient(
      circle,
      rgba(52, 211, 153, 0.40) 0%,
      rgba(34, 211, 238, 0.28) 40%,
      rgba(96, 165, 250, 0.18) 70%,
      transparent 85%
    );
  }

  @keyframes blobFloatTR {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    }
    25% {
      transform: translate3d(-75px, 45px, 0) scale(1.12) rotate(14deg);
    }
    50% {
      transform: translate3d(-35px, 95px, 0) scale(0.92) rotate(-8deg);
    }
    75% {
      transform: translate3d(50px, 40px, 0) scale(1.08) rotate(18deg);
    }
  }

  @keyframes blobFloatBL {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1) rotate(0deg);
    }
    25% {
      transform: translate3d(65px, -40px, 0) scale(1.10) rotate(-14deg);
    }
    50% {
      transform: translate3d(30px, -85px, 0) scale(0.90) rotate(10deg);
    }
    75% {
      transform: translate3d(-45px, -30px, 0) scale(1.06) rotate(-6deg);
    }
  }
</style>
