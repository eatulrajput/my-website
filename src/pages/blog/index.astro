---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getReadingTime } from '@/utils/readingTime';
import { Search, X, Sparkles, BookOpen } from 'lucide-astro';

// Fetch published blog posts sorted newest first
const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Compute tag frequency to present top topic filters
const allTags = publishedPosts.flatMap((post) => post.data.tags || []);
const tagCounts = allTags.reduce((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const popularTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([name, count]) => ({ name, count }));
---

<BaseLayout
  title="Engineering Articles & Notes — Atul Rajput"
  description="Technical deep dives on React Native performance, gesture engines, native TurboModules, offline state architecture, and system design."
>
  <div class="py-12 sm:py-20">
    <Container>
      {/* Page Header */}
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-14">
        <div class="max-w-3xl">
          <SectionHeading
            kicker="Engineering & Insights"
            title="Articles, benchmarks & deep dives"
            subtitle="Honest write-ups of engineering trade-offs, architecture decisions, mobile performance, and software lessons."
            id="blog-index-heading"
            class="mb-0"
          />
        </div>

        <div class="self-start md:self-auto shrink-0 flex items-center gap-2">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-accent-from/10 text-accent-from border border-accent-from/20 dark:bg-accent-from/15">
            <span class="w-2 h-2 rounded-full bg-accent-from animate-pulse" aria-hidden="true"></span>
            <span>{publishedPosts.length} Articles</span>
          </div>
        </div>
      </div>

      {publishedPosts.length === 0 ? (
        <div class="py-20 text-center text-muted">
          <BookOpen class="w-12 h-12 mx-auto mb-4 text-muted/50" />
          <h3 class="text-lg font-semibold text-text mb-1">No articles published yet</h3>
          <p>Check back soon for upcoming engineering write-ups!</p>
        </div>
      ) : (
        <div class="space-y-8">
          {/* Interactive Search & Filter Controls */}
          <div class="bg-surface/80 dark:bg-surface/50 rounded-2xl border border-border/80 dark:border-border/60 p-4 sm:p-5 shadow-xs">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
              {/* Search input with icons */}
              <div class="relative flex-1 max-w-xl">
                <Search class="w-4 h-4 text-muted absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" stroke-width={2} />
                <input
                  type="text"
                  id="blog-search-input"
                  placeholder="Search articles by title, topic, or keyword..."
                  class="w-full pl-10 pr-16 py-2.5 rounded-xl bg-bg/80 dark:bg-bg/60 border border-border/80 dark:border-border/60 text-sm text-text placeholder:text-muted/70 focus:outline-none focus:border-accent-from focus:ring-2 focus:ring-accent-from/20 transition-all"
                  autocomplete="off"
                  aria-label="Search articles"
                />
                <div class="absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1.5">
                  <button
                    type="button"
                    id="blog-search-clear"
                    class="hidden text-muted hover:text-text transition-colors p-1 rounded-md hover:bg-surface"
                    aria-label="Clear search"
                  >
                    <X class="w-3.5 h-3.5" />
                  </button>
                  <kbd class="hidden sm:inline-flex items-center text-[10px] text-muted font-mono bg-surface border border-border/70 px-1.5 py-0.5 rounded shadow-2xs">
                    /
                  </kbd>
                </div>
              </div>

              {/* Live Count and Reset Action */}
              <div class="flex items-center justify-between sm:justify-end gap-3 text-xs sm:text-sm text-muted">
                <span>
                  Showing <strong id="filter-count" class="text-text font-semibold">{publishedPosts.length}</strong> of {publishedPosts.length} articles
                </span>
                <button
                  type="button"
                  id="reset-filter-link"
                  class="hidden text-accent-from hover:text-accent-via font-medium transition-colors cursor-pointer"
                >
                  Reset filters
                </button>
              </div>
            </div>

            {/* Popular Topic Filter Pills */}
            <div class="mt-4 pt-4 border-t border-border/50 flex items-center gap-2 overflow-x-auto no-scrollbar pb-1 sm:pb-0" id="topic-filter-bar">
              <span class="text-xs font-semibold text-muted uppercase tracking-wider shrink-0 mr-1 hidden sm:inline-block">
                Topics:
              </span>
              <button
                type="button"
                class="topic-chip active shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer bg-accent-from text-white shadow-xs"
                data-tag="all"
              >
                All ({publishedPosts.length})
              </button>
              {popularTags.map(({ name, count }) => (
                <button
                  type="button"
                  class="topic-chip shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer bg-bg/70 dark:bg-bg/50 border border-border/70 text-muted hover:text-text hover:border-accent-from/40"
                  data-tag={name.toLowerCase()}
                >
                  {name} <span class="opacity-60 ml-0.5">({count})</span>
                </button>
              ))}
            </div>
          </div>

          {/* Empty State when search/filter returns 0 items */}
          <div
            id="blog-empty-state"
            class="hidden py-16 px-4 text-center rounded-2xl border border-dashed border-border/80 bg-surface/30 max-w-lg mx-auto"
          >
            <div class="w-14 h-14 rounded-2xl bg-accent-from/10 text-accent-from flex items-center justify-center mx-auto mb-4">
              <Search class="w-6 h-6" stroke-width={2} />
            </div>
            <h3 class="text-lg font-bold text-text mb-1">No articles found</h3>
            <p class="text-sm text-muted mb-6">
              No articles matched your current search query or topic filter.
            </p>
            <button
              type="button"
              id="empty-state-reset-btn"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-accent-from text-white hover:bg-accent-from/90 transition-all cursor-pointer shadow-xs"
            >
              Reset all filters
            </button>
          </div>

          {/* Blog Cards Grid */}
          <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {publishedPosts.map((post, idx) => {
              const postTags = post.data.tags || [];
              const readingTime = getReadingTime(post.body);

              return (
                <div
                  class="blog-card-item reveal visible"
                  style={`--delay: ${Math.min(idx * 60, 480)}ms;`}
                  data-title={post.data.title.toLowerCase()}
                  data-description={post.data.description.toLowerCase()}
                  data-tags={postTags.join(' ').toLowerCase()}
                >
                  <PostCard
                    title={post.data.title}
                    description={post.data.description}
                    date={post.data.date}
                    slug={post.id}
                    tags={postTags}
                    readingTime={readingTime}
                  />
                </div>
              );
            })}
          </div>
        </div>
      )}
    </Container>
  </div>
</BaseLayout>

<script>
  function setupBlogFiltering() {
    const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;
    const searchClear = document.getElementById('blog-search-clear') as HTMLButtonElement | null;
    const topicChips = document.querySelectorAll<HTMLButtonElement>('.topic-chip');
    const cards = document.querySelectorAll<HTMLElement>('.blog-card-item');
    const countDisplay = document.getElementById('filter-count');
    const resetLink = document.getElementById('reset-filter-link');
    const emptyState = document.getElementById('blog-empty-state');
    const emptyStateReset = document.getElementById('empty-state-reset-btn');
    const totalCount = cards.length;

    if (!searchInput || !cards.length) return;

    let activeTag = 'all';
    let searchQuery = '';

    // Check URL parameters for tag or search on load
    const urlParams = new URLSearchParams(window.location.search);
    const tagParam = urlParams.get('tag');
    const searchParam = urlParams.get('q');

    if (tagParam) {
      activeTag = tagParam.toLowerCase();
    }
    if (searchParam) {
      searchQuery = searchParam.trim().toLowerCase();
      searchInput.value = searchParam;
    }

    function updateUrl() {
      const params = new URLSearchParams();
      if (activeTag !== 'all') params.set('tag', activeTag);
      if (searchQuery) params.set('q', searchQuery);
      const newQuery = params.toString();
      const newUrl = newQuery ? `${window.location.pathname}?${newQuery}` : window.location.pathname;
      window.history.replaceState({}, '', newUrl);
    }

    function filterPosts() {
      let visibleCount = 0;
      const normalizedQuery = searchQuery.trim().toLowerCase();

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-description') || '';
        const tags = card.getAttribute('data-tags') || '';

        const matchesTag = activeTag === 'all' || tags.includes(activeTag);
        const matchesSearch =
          !normalizedQuery ||
          title.includes(normalizedQuery) ||
          desc.includes(normalizedQuery) ||
          tags.includes(normalizedQuery);

        if (matchesTag && matchesSearch) {
          card.classList.remove('hidden');
          card.classList.add('visible');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update counters and visibility
      if (countDisplay) {
        countDisplay.textContent = visibleCount.toString();
      }

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      // Toggle clear button & reset link
      if (searchClear) {
        if (normalizedQuery.length > 0) {
          searchClear.classList.remove('hidden');
        } else {
          searchClear.classList.add('hidden');
        }
      }

      if (resetLink) {
        if (activeTag !== 'all' || normalizedQuery.length > 0) {
          resetLink.classList.remove('hidden');
        } else {
          resetLink.classList.add('hidden');
        }
      }

      // Update active styling on topic chips
      topicChips.forEach((chip) => {
        const chipTag = chip.getAttribute('data-tag');
        if (chipTag === activeTag) {
          chip.className =
            'topic-chip active shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer bg-accent-from text-white shadow-xs';
        } else {
          chip.className =
            'topic-chip shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer bg-bg/70 dark:bg-bg/50 border border-border/70 text-muted hover:text-text hover:border-accent-from/40';
        }
      });

      updateUrl();
    }

    function resetFilters() {
      activeTag = 'all';
      searchQuery = '';
      if (searchInput) {
        searchInput.value = '';
      }
      filterPosts();
    }

    // Event listeners
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      filterPosts();
    });

    if (searchClear) {
      searchClear.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        filterPosts();
        searchInput?.focus();
      });
    }

    if (resetLink) {
      resetLink.addEventListener('click', resetFilters);
    }

    if (emptyStateReset) {
      emptyStateReset.addEventListener('click', resetFilters);
    }

    topicChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const tag = chip.getAttribute('data-tag') || 'all';
        activeTag = tag;
        filterPosts();
      });
    });

    // Keyboard shortcut to search: '/' or 'Cmd+K'
    window.addEventListener('keydown', (e) => {
      if (
        (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key === 'k')) &&
        document.activeElement !== searchInput
      ) {
        e.preventDefault();
        searchInput.focus();
      } else if (e.key === 'Escape' && document.activeElement === searchInput) {
        if (searchInput.value) {
          searchInput.value = '';
          searchQuery = '';
          filterPosts();
        } else {
          searchInput.blur();
        }
      }
    });

    // Run initial filter if params present
    filterPosts();
  }

  // Support both normal load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBlogFiltering);
  } else {
    setupBlogFiltering();
  }
  document.addEventListener('astro:page-load', setupBlogFiltering);
</script>
