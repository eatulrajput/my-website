---
import '@/styles/global.css';
import Header from '@/components/ui/Header.astro';
import Footer from '@/components/ui/Footer.astro';
import { siteData } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
}

const {
  title = `${siteData.name} — ${siteData.role}`,
  description = siteData.subtext,
  image = '/og-image.png',
  type = 'website',
  publishedDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://atulrajput.dev');

// Person Schema (JSON-LD) for SEO
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteData.name,
  jobTitle: siteData.role,
  url: 'https://atulrajput.dev',
  sameAs: [
    siteData.social.github,
    siteData.social.linkedin,
    siteData.social.twitter,
  ],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={siteData.name} />

    {/* Open Graph / Facebook / LinkedIn / WhatsApp */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />
    <meta property="og:site_name" content={siteData.name} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    {/* RSS feed link */}
    <link rel="alternate" type="application/rss+xml" title={`${siteData.name}'s Blog`} href="/rss.xml" />

    {/* Fonts preload for critical speed */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {/* Structured Data */}
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-text antialiased selection:bg-indigo-500/15 selection:text-indigo-900">
    {/* Accessible skip link */}
    <a href="#main" class="skip-link">
      Skip to content
    </a>

    <Header currentPath={Astro.url.pathname} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />

    {/* Lightweight reveal animation script */}
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
